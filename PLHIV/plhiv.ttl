@prefix : <https://ontologie.li3-uasz.com/OntoPLHIV/plhiv#> .
@prefix plhiv: <https://ontologie.li3-uasz.com/OntoPLHIV/plhiv> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://ontologie.li3-uasz.com/OntoPLHIV/plhiv#> .

#################################################################
#    Metadonnees
#################################################################

plhiv: rdf:type owl:Ontology ;

    dcterms:contributor
        "Ibrahima DIOP" , 
        "Youssou Dieng" ,
        "Mor Mboup";

    dcterms:creator "Camir_Augustin_Malack" ;

    dcterms:description
        "OntoVIH est une ontologie du domaine du VIH/SIDA destinée à représenter les connaissances nécessaires au suivi des personnes vivant avec le VIH. Elle couvre notamment les domaines de la maladie, de la biologie, du traitement et du patient."@fr ;

    dcterms:title "OntoVIH : Ontologie du domaine du VIH/SIDA pour le suivi des personnes vivant avec le VIH"@fr ;

    dcterms:issued "2026-09-28"^^xsd:date ;

    dcterms:language "fr" ;

    dcterms:license "li3-uasz" ;

    dcterms:modified "2026-09-28"^^xsd:date ;

    dcterms:publisher
        "Université Assane Seck de Ziguinchor"@fr ;

    dcterms:subject
        "Ontologie biomédicale"@fr ,
        "Suivi des personnes vivant avec le VIH"@fr ,
        "VIH/SIDA"@fr ;

    owl:versionInfo "1.0.0" .

#################################################################
#    Concepts
#################################################################

######## Maladie #########

### Maladie ###
:Maladie rdf:type owl:Class ;
    rdfs:label "Maladie."@fr ;
    rdfs:comment "État pathologique affectant un individu et pouvant être pris en compte dans le suivi médical des personnes vivant avec le VIH."@fr .

### Maladie Transmissible ###
:Maladie_Transmissible rdf:type owl:Class ;
    rdfs:subClassOf :Maladie_Infectieuse ;
    owl:disjointWith :Maladie_Non_Transmissible ;
    rdfs:comment "C'est une maladie transmissible."@fr ;
    rdfs:label "Maladie Transmissible."@fr .

### Maladie Non Transmissible ###
:Maladie_Non_Transmissible rdf:type owl:Class ;
    rdfs:subClassOf :Maladie ;
    owl:disjointWith :Maladie_Transmissible ;
    rdfs:comment "C'est une maladie non transmissible."@fr ;
    rdfs:label "Maladie Non Transmissible."@fr .

 