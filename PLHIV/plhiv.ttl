@prefix : <https://ontologie.li3-uasz.com/OntoPLHIV/plhiv#> .
@prefix plhiv: <https://ontologie.li3-uasz.com/OntoPLHIV/plhiv> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://ontologie.li3-uasz.com/OntoPLHIV/plhiv#> .

#################################################################
#    Metadonnees
#################################################################

plhiv: rdf:type owl:Ontology ;

    dcterms:contributor
        "Ibrahima DIOP" , 
        "Youssou Dieng" ,
        "Mor Mboup";

    dcterms:creator "Camir_Augustin_Malack" ;

    dcterms:description
        "OntoVIH est une ontologie du domaine du VIH/SIDA destinée à représenter les connaissances nécessaires au suivi des personnes vivant avec le VIH. Elle couvre notamment les domaines de la maladie, de la biologie, du traitement et du patient."@fr ;

    dcterms:title "OntoVIH : Ontologie du domaine du VIH/SIDA pour le suivi des personnes vivant avec le VIH"@fr ;

    dcterms:issued "2026-09-28"^^xsd:date ;

    dcterms:language "fr" ;

    dcterms:license "li3-uasz" ;

    dcterms:modified "2026-09-28"^^xsd:date ;

    dcterms:publisher
        "Université Assane Seck de Ziguinchor"@fr ;

    dcterms:subject
        "Ontologie biomédicale"@fr ,
        "Suivi des personnes vivant avec le VIH"@fr ,
        "VIH/SIDA"@fr ;

    owl:versionInfo "1.0.0" .

#################################################################
#    Concepts
#################################################################

######## Maladie #########

### Maladie ###
:Maladie rdf:type owl:Class ;
    rdfs:label "Maladie."@fr ;
    rdfs:comment "État pathologique affectant un individu et pouvant être pris en compte dans le suivi médical des personnes vivant avec le VIH."@fr .

### Maladie Transmissible ###
:Maladie_Transmissible rdf:type owl:Class ;
    rdfs:subClassOf :Maladie_Infectieuse ;
    owl:disjointWith :Maladie_Non_Transmissible ;
    rdfs:comment "C'est une maladie transmissible."@fr ;
    rdfs:label "Maladie Transmissible."@fr .

### Maladie Non Transmissible ###
:Maladie_Non_Transmissible rdf:type owl:Class ;
    rdfs:subClassOf :Maladie ;
    owl:disjointWith :Maladie_Transmissible ;
    rdfs:comment "C'est une maladie non transmissible."@fr ;
    rdfs:label "Maladie Non Transmissible."@fr .

        :Cancer rdf:type owl:Class ;
            rdfs:subClassOf :Maladie_Non_Transmissible .

        :Diabete rdf:type owl:Class ;
            rdfs:subClassOf :Maladie_Non_Transmissible .

        :Maladie_Cardiovasculaire rdf:type owl:Class ;
            rdfs:subClassOf :Maladie_Non_Transmissible .

        :Maladie_Inflammatoire rdf:type owl:Class ;
            rdfs:subClassOf :Maladie_Non_Transmissible .                                                          

### Maladie Infectieuse ###
:Maladie_Infectieuse rdf:type owl:Class ;
    rdfs:subClassOf :Maladie ;
    rdfs:comment "C'est une maladie infectieuse."@fr ;
    rdfs:label "Maladie Infectieuse."@fr .

### Infection Bacterienne ###
:Infection_Bacterienne rdf:type owl:Class ;
    rdfs:subClassOf :Maladie_Infectieuse ;
    rdfs:comment "C'est une infection causée par une bacterie."@fr ;
    rdfs:label "Infection Bacterienne."@fr .                                                                                         

### Infection Fongique ###
:Infection_Fongique rdf:type owl:Class ;
    rdfs:subClassOf :Maladie_Infectieuse ;
    rdfs:comment "C'est une infection causée par un champignon."@fr ;
    rdfs:label "Infection Fongique."@fr .                                                                          

### Infection Parasitaire ###
:Infection_Parasitaire rdf:type owl:Class ;
    rdfs:subClassOf :Maladie_Infectieuse ;
    rdfs:comment "C'est une infection causée par un parasite."@fr ;
    rdfs:label "Infection Parasitaire."@fr .                                                         

### Infection Virale ###
:Infection_Virale rdf:type owl:Class ;
    rdfs:subClassOf :Maladie_Infectieuse ;
    rdfs:comment "C'est une infection causée par un virus."@fr ;
    rdfs:label "Infection Virale."@fr .

### Infection VIH ###
:Infection_VIH rdf:type owl:Class ;
    rdfs:subClassOf :Infection_Virale ; 
    rdfs:comment "C'est la maladie du VIH/SIDA."@fr ;
    rdfs:label "Infection VIH."@fr .                                                                                                                                  

### Maladie Co Infectieuse ###
:Maladie_Co_Infectieuse rdf:type owl:Class ;
    rdfs:subClassOf :Maladie_Infectieuse ;
    rdfs:comment "C'est une maladie infectieuse qui co existe avec la maladie du VIH/SIDA."@fr ;
    rdfs:label "Maladie Co Infectieuse."@fr .                                         

### Maladie Comorbidite ###
:Maladie_Comorbidite rdf:type owl:Class ;
    rdfs:subClassOf :Maladie ;
    rdfs:comment "C'est une maladie non transmissible qui co existe avec la maladie du VIH/SIDA."@fr ;
    rdfs:label "Maladie Comorbidité."@fr .       

### Maladie Opportuniste ###
:Maladie_Opportuniste rdf:type owl:Class ;
    rdfs:subClassOf :Maladie ;
    rdfs:comment "C'est une maladie infectieuse qui apparait au Stade SIDA."@fr ;
    rdfs:label "Maladie Opportuniste."@fr . 
                                                                                                                                  
### Stade OMS ###
:Stade rdf:type owl:Class ;
    rdfs:comment "C'est un Stade du VIH/SIDA définit par l'OMS."@fr ;
    rdfs:label "Stade OMS."@fr .  

### Stade 1 OMS ###
:Stade_1 rdf:type owl:Class ;
    rdfs:subClassOf :Stade ;
    rdfs:comment "C'est la primo infection du VIH/SIDA définit par l'OMS."@fr ;
    rdfs:label "Stade Primo Infection."@fr .

### Stade 2 OMS ###
:Stade_2 rdf:type owl:Class ;
    rdfs:subClassOf :Stade ;
    rdfs:comment "C'est la partie asymptomatique du VIH/SIDA définit par l'OMS."@fr ;
    rdfs:label "Stade Asymptomatique."@fr .

### Stade 3 OMS ###
:Stade_3 rdf:type owl:Class ;
    rdfs:subClassOf :Stade ;
    rdfs:comment "C'est la partie symptomatique du VIH/SIDA définit par l'OMS."@fr ;
    rdfs:label "Stade Symptomatique."@fr .

### Stade 4 OMS ###
:Stade_4 rdf:type owl:Class ;
    rdfs:subClassOf :Stade ;
    rdfs:comment "C'est le Stade SIDA du VIH/SIDA définit par l'OMS."@fr ;
    rdfs:label "Stade SIDA."@fr .                        

### Mode de Transmission ###
:Mode_Transmission rdf:type owl:Class ;
    rdfs:comment "C'est le mode de transmission de la maladie infectieuse."@fr ;
    rdfs:label "Mode Transmission."@fr .

:Transmission_Directe rdf:type owl:Class ;
    rdfs:subClassOf :Mode_Transmission ;
    rdfs:comment "C'est le mode de transmission directe de la maladie infectieuse."@fr ;
    rdfs:label "Transmission Directe."@fr .

:Transmission_Indirecte rdf:type owl:Class ;
    rdfs:subClassOf :Mode_Transmission ;
    rdfs:comment "C'est le mode de transmission indirecte de la maladie infectieuse."@fr ;
    rdfs:label "Transmission Indirecte."@fr .        

### Agent de Transmission ###
:Agent_Infectieux rdf:type owl:Class ;
    rdfs:comment "C'est l'agent infectieux qui est responsable de la maladie infectieuse."@fr ;
    rdfs:label "Agent Infectieux."@fr .

### Agent Bacterie ###
:Bacterie rdf:type owl:Class ;
    rdfs:subClassOf :Agent_Infectieux ;
    rdfs:comment "C'est la bacterie qui est responsable de la maladie infectieuse."@fr ;
    rdfs:label "Agent Bacterie."@fr .

### Agent Champignon ###
:Champignon rdf:type owl:Class ;
    rdfs:subClassOf :Agent_Infectieux ;
    rdfs:comment "C'est le champignon qui est responsable de la maladie infectieuse."@fr ;
    rdfs:label "Agent Champignon."@fr .

### Agent Parasite ###
:Parasite rdf:type owl:Class ;
    rdfs:subClassOf :Agent_Infectieux ;
    rdfs:comment "C'est le parasite qui est responsable de la maladie infectieuse."@fr ;
    rdfs:label "Agent Parasite."@fr .

### Agent Virus ###
:Virus rdf:type owl:Class ;
    rdfs:subClassOf :Agent_Infectieux ;
    rdfs:comment "C'est le virus qui est responsable de la maladie infectieuse."@fr ;
    rdfs:label "Agent Virus."@fr .    

### Manifestation Clinique Maladie ###
:Manifestation_Clinique rdf:type owl:Class .                           

### Signe Maladie ###
:Signe rdf:type owl:Class ;
    rdfs:subClassOf :Manifestation_Clinique ;
    rdfs:comment "C'est un signe de la maladie du VIH/SIDA."@fr ;
    rdfs:label "Signe."@fr .     

### Symptome Maladie ###
:Symptome rdf:type owl:Class ;
    rdfs:subClassOf :Manifestation_Clinique ;
    rdfs:comment "C'est un symptome d'une maladie."@fr ;
    rdfs:label "Symptome."@fr .     

### Symptome Respiratoire ###
:Symptome_Respiratoire rdf:type owl:Class ;
    rdfs:subClassOf :Symptome ;
    rdfs:comment "C'est un symptome respiratoire d'une maladie."@fr ;
    rdfs:label "Symptome."@fr .   

        :Hemoptysie rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Respiratoire .     

        :Toux_Chronique rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Respiratoire . 

        :Dyspnee rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Respiratoire .                                       

### Symptome Digestif ###
:Symptome_Digestif rdf:type owl:Class ;
    rdfs:subClassOf :Symptome ;
    rdfs:comment "C'est un symptome digestif d'une maladie."@fr ;
    rdfs:label "Symptome."@fr .   

        :Dysphagie rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Digestif .     

        :Vomissements rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Digestif . 

        :Diarrhee_Chronique rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Digestif .    

        :Anorexie rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Digestif .                      

### Symptome Dermatologique ###
:Symptome_Dermatologique rdf:type owl:Class ;
    rdfs:subClassOf :Symptome ;
    rdfs:comment "C'est un symptome d'une maladie."@fr ;
    rdfs:label "Symptome."@fr .   

### Symptome Neurologique ###
:Symptome_Neurologique rdf:type owl:Class ;
    rdfs:subClassOf :Symptome ;
    rdfs:comment "C'est un symptome neurologique d'une maladie."@fr ;
    rdfs:label "Symptome."@fr .    

        :Neuropathies_Peripheriques rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Neurologique .     

        :Cephalee rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Neurologique . 

        :Deficit_Moteur rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Neurologique .    

        :Convulsion rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Neurologique .      

        :Coma rdf:type owl:Class ;
            rdfs:subClassOf :Symptome_Neurologique .                    

