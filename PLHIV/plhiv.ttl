#################################################################
#    Relations
#################################################################

######## Maladie #########

###  :a_pour_agent_infectieux
:a_pour_agent_infectieux rdf:type owl:ObjectProperty ;
    rdfs:domain :Maladie_Infectieuse ;
    rdfs:range :Agent_Infectieux ;
    rdfs:comment "Une maladie infectieuse a un agent infectieux."@fr ;
    rdfs:label "a pour agent infectieux."@fr .


###  :a_pour_co_infection
:a_pour_co_infection rdf:type owl:ObjectProperty ;
    rdfs:domain :Infection_VIH ;
    rdfs:range :Maladie_Infectieuse ;
    rdfs:comment "Une maladie du VIH/SIDA co existe avec une maladie infectieuse."@fr ;
    rdfs:label "a pour co infection."@fr .


###  :a_pour_comorbidite
:a_pour_comorbidite rdf:type owl:ObjectProperty ;
    owl:inverseOf :est_une_comorbidite ;
    rdfs:domain :Infection_VIH ;
    rdfs:range :Maladie ;
    rdfs:comment "Une maladie du VIH/SIDA co existe avec une maladie non transmissible."@fr ;
    rdfs:label "a pour comorbidite."@fr .


###  :a_pour_manifestation
:a_pour_manifestation rdf:type owl:ObjectProperty ;
    owl:inverseOf :est_une_manifestation_de ;
    rdfs:domain :Maladie ;
    rdfs:range :Manifestation_Clinique ;
    rdfs:comment "Une maladie a pour manisfestation clinique."@fr ;
    rdfs:label "a pour manifestation."@fr .


###  :a_pour_mode_transmission
:a_pour_mode_transmission rdf:type owl:ObjectProperty ;
    rdfs:domain :Maladie_Transmissible ;
    rdfs:range :Mode_Transmission ;
    rdfs:comment "Une maladie transmissible a un mode de transmission."@fr ;
    rdfs:label "a pour mode transmission."@fr .


###  :a_pour_opportuniste
:a_pour_opportuniste rdf:type owl:ObjectProperty ;
    owl:inverseOf :est_une_opportuniste ;
    rdfs:domain :Stade ;
    rdfs:range :Maladie ;
    rdfs:comment "Le Stade SIDA a une maladie opportuniste."@fr ;
    rdfs:label "a pour opportuniste."@fr .


###  :a_pour_stade
:a_pour_stade rdf:type owl:ObjectProperty ;
    rdfs:domain :Infection_VIH ;
    rdfs:range :Stade ;
    rdfs:comment "Une maladie du VIH/SIDA a un Stade OMS."@fr ;
    rdfs:label "a pour stade."@fr .


###  :est_un_agent_infectieux
:est_un_agent_infectieux rdf:type owl:ObjectProperty ;
    owl:inverseOf :a_pour_agent_infectieux ;
    rdfs:domain :Agent_Infectieux ;
    rdfs:range :Maladie_Infectieuse ;
    rdfs:comment "Un agent infectieux d'une maladie infectieuse."@fr ;
    rdfs:label "est un agent infectieux."@fr .


###  :est_un_mode_transmission
:est_un_mode_transmission rdf:type owl:ObjectProperty ;
    owl:inverseOf :a_pour_mode_transmission ;
    rdfs:domain :Mode_Transmission ;
    rdfs:range :Maladie_Transmissible ;
    rdfs:comment "Un mode de transmission d'une maladie transmissible."@fr ;
    rdfs:label "est un mode transmission."@fr .


###  :est_un_stade
:est_un_stade rdf:type owl:ObjectProperty ;
    owl:inverseOf :a_pour_stade ;
    rdfs:domain :Stade ;
    rdfs:range :Infection_VIH ;
    rdfs:comment "Un Stade OMS d'une maladie du VIH/SIDA."@fr ;
    rdfs:label "est un stade."@fr .


###  :est_une_co_infection
:est_une_co_infection rdf:type owl:ObjectProperty ;
    owl:inverseOf :a_pour_co_infection ;
    rdfs:domain :Maladie_Infectieuse ;
    rdfs:range :Infection_VIH ;
    rdfs:comment "Une maladie infectieuse co existe avec une maladie du du VIH/SIDA."@fr ;
    rdfs:label "est une co infection."@fr .


###  :est_une_comorbidite
:est_une_comorbidite rdf:type owl:ObjectProperty ;
    rdfs:domain :Maladie ;
    rdfs:range :Infection_VIH ;
    rdfs:comment "Une maladie transmissible co existe avec une maladie du du VIH/SIDA."@fr ;
    rdfs:label "est une comorbidite."@fr .


###  :est_une_manifestation_de
:est_une_manifestation_de rdf:type owl:ObjectProperty ;
    rdfs:domain :Manifestation_Clinique ;
    rdfs:range :Maladie ;
    rdfs:comment "Une manisfestation clinique d'une maladie ."@fr ;
    rdfs:label "est une manifestation de ."@fr .


###  :est_une_manifestation_du
:est_une_manifestation_du rdf:type owl:ObjectProperty ;
    owl:inverseOf :se_manifeste_par ;
    rdfs:domain :Manifestation_Clinique ;
    rdfs:range :Stade ;
    rdfs:comment "Une manisfestation clinique d'un stade ."@fr ;
    rdfs:label "est une manifestation du ."@fr .


###  :est_une_opportuniste
:est_une_opportuniste rdf:type owl:ObjectProperty ;
    rdfs:domain :Maladie ;
    rdfs:range :Stade ;
    rdfs:comment "Une maladie opportuniste apparait au Stade SIDA."@fr ;
    rdfs:label "est une opportuniste."@fr .


###  :se_manifeste_par
:se_manifeste_par rdf:type owl:ObjectProperty ;
    rdfs:domain :Stade ;
    rdfs:range :Manifestation_Clinique ;
    rdfs:comment "Un Stade a une manisfestation clinique."@fr ;
    rdfs:label "se manifeste par."@fr .

######## Traitement #########

:a_pour_echec_therapeutique rdf:type owl:ObjectProperty ;
    rdfs:domain :Traitement ;
    rdfs:range :Echec_Therapeutique .    

:a_pour_resistance_therapeutique rdf:type owl:ObjectProperty ;
    rdfs:domain :Traitement ;
    rdfs:range :Resistance_Therapeutique .       

:a_comme_medicament rdf:type owl:ObjectProperty ;
    rdfs:domain :Traitement ;
    rdfs:range :Medicament .

:a_pour_effet_secondaire rdf:type owl:ObjectProperty ;
    rdfs:domain :Medicament ;
    rdfs:range :Effet_Secondaire .

:a_pour_effet_indesirable rdf:type owl:ObjectProperty ;
    rdfs:domain :Medicament ;
    rdfs:range :Effet_Indesirable .

:a_pour_protocole_ARV rdf:type owl:ObjectProperty ;
    rdfs:domain :Traitement ;
    rdfs:range :Protocole_ARV .    

:a_comme_antiretroviral rdf:type owl:ObjectProperty ;
    rdfs:domain :Protocole_ARV ;
    rdfs:range :Antiretroviral .   

:a_comme_medicament owl:propertyChainAxiom (
    :a_pour_protocole_ARV
    :a_comme_antiretroviral
) .

######## Biologie #########

######## Patient #########

:a_pour_allergie rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Allergie .  

:a_pour_comportement_risque rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Comportement_Risque .      

:est_suivi_par rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Personnel_Sante;
    owl:inverseOf :suit_patient .

:suit_patient rdf:type owl:ObjectProperty ;
    rdfs:domain :Personnel_Sante ;
    rdfs:range :Patient;
    owl:inverseOf :est_suivi_par .      

:a_pour_reference rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Reference ;
    owl:inverseOf :concerne_patient .   

:concerne_patient rdf:type owl:ObjectProperty ;
    rdfs:domain :Reference ;
    rdfs:range :Patient ;
    owl:inverseOf :a_pour_reference .       

:a_pour_motif rdf:type owl:ObjectProperty ;
    rdfs:domain :Reference ;
    rdfs:range :Motif .      

:a_pour_renseignement_clinique rdf:type owl:ObjectProperty ;
    rdfs:domain :Reference ;
    rdfs:range :Renseignement_Clinique .      

:est_envoye_par rdf:type owl:ObjectProperty ;
    rdfs:domain :Reference ;
    rdfs:range :Personnel_Sante ;
    owl:inverseOf :envoie_reference .

:envoie_reference rdf:type owl:ObjectProperty ;
    rdfs:domain :Personnel_Sante ;
    rdfs:range :Reference ;
    owl:inverseOf :est_envoye_par .    

:est_recu_par rdf:type owl:ObjectProperty ;
    rdfs:domain :Reference ;
    rdfs:range :Personnel_Sante ;
    owl:inverseOf :recoit_reference .

:recoit_reference rdf:type owl:ObjectProperty ;
    rdfs:domain :Personnel_Sante ;
    rdfs:range :Reference ;
    owl:inverseOf :est_recu_par .  

#################################################################
#    Attributs
#################################################################

######## Maladie #########

######## Traitement #########

######## Biologie #########

######## Patient #########

#################################################################
#    Axiomes
#################################################################

######## Maladie #########

:Maladie_Transmissible rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Restriction ;
        owl:onProperty :a_pour_mode_transmission ;
        owl:someValuesFrom :Mode_Transmission ] ;
    owl:disjointWith :Maladie_Non_Transmissible .

:Maladie_Non_Transmissible rdf:type owl:Class ;
    owl:disjointWith :Maladie_Transmissible .                                                           

:Maladie_Infectieuse rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Restriction ;
        owl:onProperty :a_pour_agent_infectieux ;
        owl:someValuesFrom :Agent_Infectieux ] .

:Infection_Bacterienne rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Restriction ;
        owl:onProperty :a_pour_agent_infectieux ;
        owl:someValuesFrom :Bacterie ] .                                                                                       

:Infection_Fongique rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Restriction ;
        owl:onProperty :a_pour_agent_infectieux ;
        owl:someValuesFrom :Champignon ] .                                                                         

:Infection_Parasitaire rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Restriction ;
        owl:onProperty :a_pour_agent_infectieux ;
        owl:someValuesFrom :Parasite ] .                                                      

:Infection_Virale rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Restriction ;
        owl:onProperty :a_pour_agent_infectieux ;
        owl:someValuesFrom :Virus ] .   
                                                                                            
:Maladie_Co_Infectieuse rdf:type owl:Class ;
    owl:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :est_une_co_infection ;
        owl:someValuesFrom :Infection_VIH ] .                                                                

:Maladie_Comorbidite rdf:type owl:Class ;
    owl:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :est_une_comorbidite ;
        owl:someValuesFrom :Infection_VIH ] .       

:Maladie_Opportuniste rdf:type owl:Class ;
    owl:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :est_une_opportuniste ;
        owl:someValuesFrom :Stade ] . 

:Infection_VIH rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :a_pour_stade ;
        owl:someValuesFrom :Stade ] . 

:Stade_3 rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :se_manifeste_par ;
        owl:someValuesFrom :Manifestation_Clinique ] . 

:Stade_4 rdf:type owl:Class ;
    rdfs:subClassOf  [ rdf:type owl:Restriction ;
            owl:onProperty :se_manifeste_par ;
            owl:someValuesFrom :Manifestation_Clinique 
        ] , 
        [ rdf:type owl:Restriction ;
            owl:onProperty :a_pour_opportuniste ;
            owl:someValuesFrom :Maladie_Opportuniste 
        ] .   

######## Traitement #########

:Traitement_Infection_VIH rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :a_pour_protocole_ARV ;
        owl:someValuesFrom :Protocole_ARV ] . 

:Protocole_ARV rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :a_comme_antiretroviral ;
        owl:someValuesFrom :Antiretroviral ] . 

:Protocole_ARV rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :a_comme_antiretroviral ;
        owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
        owl:onClass :Antiretroviral ] .   

######## Biologie #########

######## Patient #########

:Reference rdf:type owl:Class ;
    rdfs:subClassOf [ rdf:type owl:Restriction ;
        owl:onProperty :concerne_patient ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :Patient 
    ],
    [ rdf:type owl:Restriction ;
        owl:onProperty :est_envoye_par ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :Personnel_Sante
    ] ,
    [ rdf:type owl:Restriction ;
        owl:onProperty :est_recu_par ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass :Personnel_Sante
    ] .

#################################################################
# Relations entre sous-domaines    
#################################################################

:a_pour_maladie rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Maladie .

:a_pour_infection_VIH rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :a_pour_maladie ;
    rdfs:domain :Patient ;
    rdfs:range :Infection_VIH .

:a_pour_examen rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Examen_Biologique ;
    owl:inverseOf :est_examen_de .

:est_examen_de rdf:type owl:ObjectProperty ;
    rdfs:domain :Examen_Biologique ;
    rdfs:range :Patient ;
    owl:inverseOf :a_pour_examen .

:a_pour_traitement rdf:type owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :Traitement ;
    owl:inverseOf :est_traitement_de .

:est_traitement_de rdf:type owl:ObjectProperty ;
    rdfs:domain :Traitement ;
    rdfs:range :Patient ;
    owl:inverseOf :a_pour_traitement .

:traite_maladie rdf:type owl:ObjectProperty ;
    rdfs:domain :Traitement ;
    rdfs:range :Maladie .

:traite_infection_VIH rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :traite_maladie ;
    rdfs:domain :Traitement_Infection_VIH ;
    rdfs:range :Infection_VIH .

:examine_maladie rdf:type owl:ObjectProperty ;
    rdfs:domain :Examen_Biologique ;
    rdfs:range :Maladie .

:examine_infection_VIH rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :examine_maladie ;
    rdfs:domain :Examen_Infection_VIH ;
    rdfs:range :Infection_VIH .