<http://example.org/plhiv> rdf:type owl:Ontology ;
                            owl:imports <http://loinc.org> ,
                                        <http://purl.bioontology.org/ontology/RXNORM> ,
                                        <http://snomed.info/sct/2025> ;
                            <http://purl.org/dc/terms/contributor> <http://www.semanticweb.org/owl/owlapi/turtle#Experts_VIH_SIDA> ,
