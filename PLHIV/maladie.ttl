                            <http://purl.org/dc/terms/creator> <http://www.semanticweb.org/owl/owlapi/turtle#Camir_Augustin_Malack> ;
                            <http://purl.org/dc/terms/description> "OntoVIH est une ontologie du domaine du VIH/SIDA destinée à représenter les connaissances nécessaires au suivi des personnes vivant avec le VIH. Elle couvre notamment les domaines de la maladie, de la biologie, du traitement et du patient."@fr ;
                            <http://purl.org/dc/terms/issued> "2026-09-28"^^xsd:date ;
                            <http://purl.org/dc/terms/language> "fr" ;
