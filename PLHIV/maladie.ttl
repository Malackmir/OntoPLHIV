                            <http://purl.org/dc/terms/modified> "2026-09-28"^^xsd:date ;
                            <http://purl.org/dc/terms/publisher> "Université Assane Seck de Ziguinchor"@fr ;
                            <http://purl.org/dc/terms/source> <http://www.semanticweb.org/owl/owlapi/turtle#Documents_Suivi_Medical_PVVIH> ,
                                                              <http://www.semanticweb.org/owl/owlapi/turtle#Entretiens_Experts> ,
                                                              <http://www.semanticweb.org/owl/owlapi/turtle#Fiche_Reference_FEVE> ;
                            <http://purl.org/dc/terms/subject> "Ontologie biomédicale"@fr ,
                                                               "Suivi des personnes vivant avec le VIH"@fr ,
                                                               "Suivi médical"@fr ,
                                                               "VIH/SIDA"@fr ;
                            <http://purl.org/dc/terms/title> "OntoVIH : Ontologie du domaine du VIH/SIDA pour le suivi des personnes vivant avec le VIH"@fr ;
                            rdfs:label "OntoVIH"@fr ;
                            owl:versionInfo "1.0.0" .