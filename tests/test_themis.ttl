```turtle
@prefix : <https://ontologie.li3-uasz.com/OntoPLHIV/tests#> .
@prefix plhiv: <https://ontologie.li3-uasz.com/OntoPLHIV/plhiv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://ontologie.li3-uasz.com/OntoPLHIV/tests>
    a owl:Ontology ;
    rdfs:label "Tests de validation de l'ontologie OntoPLHIV"@fr .

:Test_Maladie
    a owl:Class ;
    rdfs:label "Test de la classe Maladie"@fr ;
    rdfs:comment "Vérifier que Maladie est déclarée comme classe."@fr ;
    :classeCible plhiv:Maladie .

:Test_Maladie_Opportuniste
    a owl:Class ;
    rdfs:label "Test de la classe Maladie Opportuniste"@fr ;
    rdfs:comment "Vérifier que Maladie_Opportuniste est déclarée comme classe et sous-classe de Maladie."@fr ;
    :classeCible plhiv:Maladie_Opportuniste ;
    :superClasseAttendue plhiv:Maladie .

:Test_Maladie_Comorbidite
    a owl:Class ;
    rdfs:label "Test de la classe Maladie Comorbidité"@fr ;
    rdfs:comment "Vérifier que Maladie_Comorbidite est déclarée comme classe et sous-classe de Maladie."@fr ;
    :classeCible plhiv:Maladie_Comorbidite ;
    :superClasseAttendue plhiv:Maladie .

:Test_Maladie_Co_Infectieuse
    a owl:Class ;
    rdfs:label "Test de la classe Maladie Co-Infectieuse"@fr ;
    rdfs:comment "Vérifier que Maladie_Co_Infectieuse est déclarée comme classe et sous-classe de Maladie_Infectieuse."@fr ;
    :classeCible plhiv:Maladie_Co_Infectieuse ;
    :superClasseAttendue plhiv:Maladie_Infectieuse .
```
